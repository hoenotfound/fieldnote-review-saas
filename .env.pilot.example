# Preparation only. Do not overwrite your working .env.local.
# Fill in only after approval for a NEW, isolated Neon project and Render service.
APP_MODE=pilot
APP_ORIGIN=https://your-approved-review-domain.example
REVIEW_DATABASE_APPROVED=yes
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEW-PROJECT.neon.tech/DB?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-new-random-secret-at-least-32-characters
AI_MODE=gemini
GEMINI_API_KEY=replace-with-review-project-key
GEMINI_MODEL=replace-with-your-tested-model
AI_DAILY_ATTEMPT_LIMIT=10
# Optional, first startup only on an empty account database:
# INITIAL_ADMIN_EMAIL=your-admin-email
# INITIAL_ADMIN_PASSWORD=choose-privately-12-to-128-characters
# Remove both settings after verifying the first admin sign-in.

# Optional guest/AI limits (database-backed; adjust after a shared Wi-Fi test):
# GUEST_SESSIONS_PER_NETWORK_HOUR=20
# GUEST_SESSIONS_PER_NETWORK_DAY=60
# GUEST_SESSIONS_PER_BUSINESS_DAY=200
# AI_ATTEMPTS_PER_NETWORK_HOUR=8
# AI_ATTEMPTS_PER_NETWORK_DAY=12
# AI_BUSINESS_DAILY_ATTEMPT_LIMIT=6
# Unverified visitors can use 2 AI requests per browser and 3 per network
# per day (at a 6-attempt business cap). More requests require Turnstile.
# AI_UNVERIFIED_BROWSER_DAILY_LIMIT=2
# AI_UNVERIFIED_NETWORK_DAILY_LIMIT=3
# Optional, configure BOTH for shared clinic Wi-Fi use above these limits:
# TURNSTILE_SITE_KEY=your-public-site-key
# TURNSTILE_SECRET_KEY=your-private-secret-key
# Verify the real Render Cloudflare visitor headers before trusting limits.
# Daily retention cleanup: use a separate random secret of at least 32 chars.
# Set the same secret in GitHub Actions as FIELDNOTE_MAINTENANCE_TOKEN.
# MAINTENANCE_SECRET=replace-with-a-unique-secret-32-chars-or-more
