{
  "name": "lean-review-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "test": "node --env-file=.env.local --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "setup": "node scripts/setup.mjs",
    "migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "create-owner": "node --env-file-if-exists=.env.local --import tsx scripts/create-owner.ts",
    "pilot:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-pilot.ts",
    "netlify:build": "node scripts/check-netlify-trial.mjs && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@google/genai": "3.0.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
