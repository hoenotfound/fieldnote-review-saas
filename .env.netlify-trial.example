# Copy values to Netlify > Project configuration > Environment variables.
# This file contains NO real credentials. Do not commit filled-in values.
HOSTING_PROVIDER=netlify
APP_MODE=pilot
APP_ORIGIN=https://YOUR-NETLIFY-SITE.netlify.app
REVIEW_DATABASE_APPROVED=yes
# Use ONLY the new Neon project morning-cloud-02172364, database fieldnote_trial.
# Copy its POOLED connection string and change sslmode=require to sslmode=verify-full.
# Must be enabled for both Builds and Functions in the Netlify site.
# DATABASE_URL, if set by a Netlify extension, is intentionally IGNORED.
FIELDNOTE_TRIAL_DATABASE_URL=postgresql://TRIAL_USER:TRIAL_PASSWORD@TRIAL_POOLER_HOST.neon.tech/fieldnote_trial?sslmode=verify-full
NETLIFY_TRIAL_MARKER=fieldnote-netlify-trial-morning-cloud-02172364
BETTER_AUTH_SECRET=SET_A_NEW_RANDOM_32_PLUS_CHARACTER_TRIAL_ONLY_SECRET
MAINTENANCE_SECRET=SET_A_DIFFERENT_RANDOM_32_PLUS_CHARACTER_TRIAL_ONLY_SECRET
AI_MODE=gemini
GEMINI_API_KEY=TRIAL_GEMINI_KEY
GEMINI_MODEL=YOUR_SUPPORTED_GEMINI_MODEL
AI_DAILY_ATTEMPT_LIMIT=5
AI_BUSINESS_DAILY_ATTEMPT_LIMIT=3
# Set the following only for the first deployment, then delete and redeploy:
INITIAL_ADMIN_EMAIL=YOUR_REAL_EMAIL
INITIAL_ADMIN_PASSWORD=CHOOSE_A_NEW_12_TO_128_CHARACTER_PASSWORD
# Create a separate Turnstile widget for the EXACT new .netlify.app hostname.
# Add BOTH keys together for the live challenge test.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# SITE_ID is a Netlify-provided runtime variable. Do not copy an ID from another site.
